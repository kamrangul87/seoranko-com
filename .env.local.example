# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://ddfboapzwclecbdjoqex.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hosted publish route — the subdomain articles go live on (see
# next.config.js's rewrites + publish-hosted.ts). Defaults to
# blog.seoranko.com when unset; the actual subdomain DNS/domain still needs
# to be added to the Vercel project separately, this only controls the code.
NEXT_PUBLIC_PUBLISH_DOMAIN=blog.seoranko.com

# Keyword data API credentials
DATAFORSEO_EMAIL=
DATAFORSEO_PASSWORD=

# AI API key
ANTHROPIC_API_KEY=

# Vercel deploy hook — triggers autodun.com redeploy after a RANKO fix is pushed
VERCEL_DEPLOY_HOOK_AUTODUN=

# Vercel deploy hook — brand-agnostic single-site fallback for the real-publish
# GitHub adapter (src/lib/publisher-adapters/github-publisher.ts). Per-site
# deployHookUrl (stored in site_connections.credentials) always takes
# priority once more than one site is connected; this is only a convenience
# default while testing with a single connected site.
VERCEL_DEPLOY_HOOK_DEFAULT=

# Master account (admin access — unlimited usage, no rate limits)
MASTER_EMAIL=
MASTER_PASSWORD=

# AES-256-GCM key for site_connections credentials at rest (Fix Agent).
# Prefer a dedicated 32+ char secret. Falls back to hashing SUPABASE_SERVICE_ROLE_KEY.
SITE_CONNECTION_ENCRYPTION_KEY=

# Phase 2 — GEO Toolkit
# Get Perplexity API key from: https://console.perplexity.ai/account/setup
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Generate any random string for securing cron endpoints
# Example: seoranko_cron_2026_xK9mP3qR7vL2nJ5w
CRON_SECRET=your_cron_secret_here

# Free image generation — stock-first architecture. Pexels + Unsplash are
# queried in parallel as the reliable PRIMARY source for every image (real,
# pre-approved photos — no safety filters, no generation quota). Gemini is
# an optional, non-blocking enhancement tried only for the hero image; any
# Gemini failure just means the stock result already in flight is used.
# pollinations.ai (no key needed) is the automatic last-resort fallback if
# all configured keys are unset or every provider above fails, so image
# generation keeps working before these are configured.
# Get a Pexels key: https://pexels.com/api (free, 200 requests/hour)
PEXELS_API_KEY=
# Get an Unsplash key: https://unsplash.com/developers (free, 50 requests/hour)
UNSPLASH_ACCESS_KEY=
# Get a Gemini key: https://aistudio.google.com (Get API key) — optional,
# hero-only enhancement, not required for image generation to work
GEMINI_API_KEY=

# Core Web Vitals (Site Audit 8th dimension) — Google PageSpeed Insights API.
# Optional: PSI works without a key at a lower quota; a key raises limits.
# Create at https://console.cloud.google.com/apis/credentials (enable PageSpeed Insights API)
PAGESPEED_API_KEY=

# AI Visibility (citation check) — Phase 1 engines
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini). Used with Responses API + web_search.
OPENAI_CITATION_MODEL=gpt-4o-mini
# Perplexity Sonar — returns real source citations
PERPLEXITY_API_KEY=
# Max tracked prompts per site (default 15)
AI_VISIBILITY_PROMPT_CAP=15
