# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://ddfboapzwclecbdjoqex.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Keyword data API credentials
DATAFORSEO_EMAIL=
DATAFORSEO_PASSWORD=

# AI API key
ANTHROPIC_API_KEY=

# Vercel deploy hook — triggers autodun.com redeploy after a fix is pushed
VERCEL_DEPLOY_HOOK_AUTODUN=

# Master account (admin access — unlimited usage, no rate limits)
MASTER_EMAIL=
MASTER_PASSWORD=

# Phase 2 — GEO Toolkit
# Get Perplexity API key from: https://console.perplexity.ai/account/setup
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Generate any random string for securing cron endpoints
# Example: seoranko_cron_2026_xK9mP3qR7vL2nJ5w
CRON_SECRET=your_cron_secret_here

# Free image generation — Gemini (primary) + Pexels (fallback). Both free
# tiers, no credit card required. pollinations.ai (no key needed) is the
# automatic final fallback if either is unset, so image generation keeps
# working before these are configured.
# Get a Gemini key: https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# Get a Pexels key: https://pexels.com/api
PEXELS_API_KEY=
