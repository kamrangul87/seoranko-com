{
  "framework": "nextjs",
  "github": {
    "silent": true
  },
  "functions": {
    "src/app/api/pipeline/write/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/gsc-sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/scheduled-recrawl/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/fix-agent-e2e/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/fix-agent-e2e/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/fix-agent-e2e",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scheduled-recrawl",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/weekly-jobs",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/verify-liveness",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/verify-publications",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/gsc-sync",
      "schedule": "0 11 * * *"
    }
  ]
}
